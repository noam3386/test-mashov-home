rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isParent() {
      return isAuth() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'parent';
    }

    match /members/{memberId} {
      allow read: if isAuth();
      allow write: if isParent();
    }

    match /tasks/{taskId} {
      allow read: if isAuth();
      allow create, delete: if isParent();
      allow update: if isAuth() && (
        isParent() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])
      );
    }

    match /schedule/{eventId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /schoolUpdates/{updateId} {
      allow read: if isAuth();
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /config/{configId} {
      allow read: if isParent();
      allow write: if false;
    }
  }
}
