rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isParent() {
      return isAuth() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'parent';
    }

    // תצוגה ציבורית — קריאה חופשית (דשבורד ביתי)
    match /schedule/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /schoolUpdates/{updateId} {
      allow read: if true;
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, delete: if isParent();
      allow update: if isAuth() || isParent();
    }

    match /members/{memberId} {
      allow read: if true;
      allow write: if isParent();
    }

    match /timetable/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // config — רק Admin SDK
    match /config/{configId} {
      allow read: if isParent();
      allow write: if false;
    }
  }
}
