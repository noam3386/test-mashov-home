rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Multi-tenant family data ────────────────────────────────────────────
    // Each family's data lives under /families/{familyId}/...
    // Only the authenticated user who owns the family can read/write their data.

    match /families/{familyId}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == familyId;
    }

    // Settings (credentials) — writable by the owner, readable by owner
    // The GitHub Actions Admin SDK bypasses these rules entirely.
    match /families/{familyId}/settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == familyId;
    }

    // Config (sync status written by Admin SDK) — readable by owner, not writable from browser
    match /families/{familyId}/config/{doc} {
      allow read: if request.auth != null && request.auth.uid == familyId;
      allow write: if false;
    }
  }
}
